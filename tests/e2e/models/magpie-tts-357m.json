{
  "name": "magpie-tts-357m",
  "hf_id": "nvidia/magpie_tts_multilingual_357m",
  "bundle": "magpie-tts-357m.trtfb",
  "family": "magpie_tts",
  "runtime_strategy": "text_to_audio",
  "reference_backend": "invariant_only",
  "test_type": "audio",
  "max_cache_length": 512,
  "prompt": "Hello, this is a test of text to speech.",
  "max_new_tokens": 200,
  "logit_atol": 1e-2,
  "trust_remote_code": false,
  "env": {
    "TRTF_MAGPIE_GREEDY": "1"
  },
  "preflight_requirements": [
    {
      "kind": "binary_exists",
      "args": {},
      "gating": true
    },
    {
      "kind": "python_module_available",
      "args": {
        "module": "nemo.collections.tts.g2p.models.i18n_ipa"
      },
      "gating": true
    }
  ],
  "skip": "HF reference requires nemo_toolkit not available in test environment"
}
